# Set default behavior to automatically normalize line endings.
* text=auto

# Force LF line endings for common text files.
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md text eol=lf
*.prisma text eol=lf
*.env* text eol=lf
*.svg text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
